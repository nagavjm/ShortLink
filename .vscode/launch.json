{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "🚀 Full Stack: Backend (.NET API) + Frontend (Angular)",
      "configurations": [
        "Launch Backend (.NET 8 Web API)",
        "Launch Frontend (Chrome/Edge)"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Launch Backend (.NET 8 Web API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/src/ShortLink.API/bin/Debug/net8.0/ShortLink.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ShortLink.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Launch Frontend (Chrome/Edge)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "start-frontend"
    },
    {
      "name": "Launch Frontend (Microsoft Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "start-frontend"
    },
    {
      "name": "Attach to .NET API Process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
